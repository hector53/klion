# ============================================
# Klion Production Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp env.production.example .env

# ============================================
# Database (PostgreSQL + pgvector)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=clientboard

# ============================================
# Backend (NestJS API)
# ============================================
# First user created when the database is empty
MASTER_USER_EMAIL=admin@your-domain.example
MASTER_USER_PASSWORD=generate-a-unique-password
MASTER_USER_NAME=Admin

# JWT secret for authentication (generate a secure random string)
JWT_SECRET=your-jwt-secret-key-min-32-chars

# Frontend URL for CORS
FRONTEND_URL=https://klion.yourdomain.com

# ============================================
# AI API Keys (for RAG embeddings and chat)
# ============================================
# At least one is required for semantic search
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ============================================
# Frontend (Next.js)
# ============================================
# Public API URL (accessed by browser)
NEXT_PUBLIC_API_URL=https://klion.yourdomain.com/api

# NextAuth configuration
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=https://klion.yourdomain.com

# ============================================
# Optional: Custom ports (defaults shown)
# ============================================
# API_PORT=3001
# WEB_PORT=3500
